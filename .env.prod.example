# Production compose config. Copy to .env next to compose.prod.yaml.
#   cp .env.prod.example .env
#   docker compose -f compose.prod.yaml up -d

# Image tag for both pgbr images. Pin to a release, e.g. 2.4.1.
PGBR_VERSION=latest

# Required. openssl rand -base64 32
ENCRYPTION_KEY=
AUTH_SECRET=

# Required. The URL you open in the browser, including scheme.
BASE_URL=https://pgbr.example.com

# Required. URL-safe characters only.
POSTGRES_PASSWORD=
POSTGRES_USER=pgbr
POSTGRES_DB=pgbr

# Set PGBR_BIND_ADDR=127.0.0.1 when a reverse proxy fronts the dashboard.
PGBR_BIND_ADDR=0.0.0.0
PGBR_PORT=3000

WORKER_CONCURRENCY=5

# Object storage. Defaults target the SeaweedFS service; point these at S3, R2
# or Backblaze for real durability and drop the seaweedfs service.
STORAGE_ENDPOINT=http://seaweedfs:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pgbr
STORAGE_ACCESS_KEY_ID=pgbr
STORAGE_SECRET_ACCESS_KEY=pgbrsecret
STORAGE_FORCE_PATH_STYLE=true

SEAWEEDFS_VERSION=4.40
