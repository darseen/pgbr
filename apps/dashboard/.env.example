DATABASE_URL=postgresql://root:password@postgres:5432/pgbr
REDIS_URL=redis://redis:6379

ENCRYPTION_KEY= # generate with: openssl rand -base64 32 — must match the worker's ENCRYPTION_KEY. Also encrypts stored storage credentials.

AUTH_SECRET= # generate with: openssl rand -base64 32

# Required unless you reach the dashboard directly on localhost. Auth rejects
# any origin that isn't derived from this, and detection from the request sees
# the container's internal address — not your public URL — behind a proxy.
BASE_URL=http://localhost:3000

# Object storage — defaults target the bundled SeaweedFS. Must match the worker.
# The settings page auto-checks this connection; if it's reachable it shows the
# active config as read-only, otherwise it shows fields to configure a store
# (persisted encrypted in the database, overriding these env vars).
STORAGE_ENDPOINT=http://seaweedfs:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pgbr
STORAGE_ACCESS_KEY_ID=pgbr
STORAGE_SECRET_ACCESS_KEY=pgbrsecret
STORAGE_FORCE_PATH_STYLE=true
