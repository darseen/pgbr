PGBR_DATA=/var/lib/pgbr/data
DATABASE_URL=postgresql://root:password@postgres:5432/pgbr
REDIS_URL=redis://redis:6379

ENCRYPTION_KEY= # generate with: openssl rand -base64 32 — must match the worker's ENCRYPTION_KEY

AUTH_SECRET= # generate with: openssl rand -base64 32

# Optional — auto-detected from incoming requests if unset. Set this only if
# you're behind a reverse proxy that doesn't forward the Host header correctly.
# BASE_URL=http://localhost:3000
