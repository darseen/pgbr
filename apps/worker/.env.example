DATABASE_URL=postgresql://root:password@postgres:5432/pgbr
REDIS_URL=redis://redis:6379

ENCRYPTION_KEY= # generate with: openssl rand -base64 32 — must match the dashboard's ENCRYPTION_KEY

WORKER_CONCURRENCY=5

# Object storage — defaults target the SeaweedFS service. Must match the
# dashboard. The worker resolves the active connection from the database at job
# time (a settings-page override) and otherwise falls back to these values.
STORAGE_ENDPOINT=http://seaweedfs:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pgbr
STORAGE_ACCESS_KEY_ID=pgbr
STORAGE_SECRET_ACCESS_KEY=pgbrsecret
STORAGE_FORCE_PATH_STYLE=true
