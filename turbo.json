{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "AUTH_SECRET",
    "BASE_URL",
    "NODE_ENV",
    "NEXT_TELEMETRY_DISABLED",
    "DATABASE_URL",
    "ENCRYPTION_KEY",
    "DATABASE_POOL_MAX",
    "WORKER_CONCURRENCY",
    "STORAGE_ENDPOINT",
    "STORAGE_REGION",
    "STORAGE_BUCKET",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_SECRET_ACCESS_KEY",
    "STORAGE_FORCE_PATH_STYLE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    }
  }
}
